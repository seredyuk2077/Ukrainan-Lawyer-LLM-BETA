# Lexery Legal Agent — U1 Gateway
# Copy to .env and fill values

# Server
BRAIN_PORT=3081
NODE_ENV=development

# Dev Auth (LEX-69)
DEV_API_KEY=your-dev-key-here
DEV_ALLOW_ANONYMOUS=true

# Supabase LEXERY LEGAL AGENT DB
SUPABASE_LEXERY_LEGAL_AGENT_DB_URL=https://xxx.supabase.co
SUPABASE_LEXERY_LEGAL_AGENT_DB_ANON_KEY=
SUPABASE_LEXERY_LEGAL_AGENT_DB_SERVICE_ROLE_KEY=

# R2 (for attachments overflow)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RUNS_BUCKET=lexery-legal-agent
R2_LEGISLATION_BUCKET=legislation
# Create lexery-legal-agent bucket in Cloudflare R2 if using overflow attachments.

# MM Docs
MM_DOCS_ENABLED=true
MM_DOCS_BUCKET=lexery-legal-agent
MM_DOCS_RAW_MAX_BYTES=12000000
MM_DOCS_TOP_K=8
MM_DOCS_QDRANT_TIMEOUT_MS=6000
# MM Docs uses its own collection inside Lexery-LA by default.
# Set docs-specific endpoint/api key only if you intentionally isolate MM Docs onto another cluster.
MM_DOCS_QDRANT_URL=
MM_DOCS_QDRANT_API_KEY=
MM_DOCS_QDRANT_COLLECTION=lexery_mm_docs_chunks_v1
# Legacy compatibility flag. Shared-cluster mode is already the default topology.
MM_DOCS_QDRANT_USE_MEMORY_FALLBACK=false
MM_DOCS_VISION_ENABLED=true
MM_DOCS_VISION_MODEL_ID=openai/gpt-4o-mini
MM_DOCS_VISION_TIMEOUT_SEC=18
MM_DOCS_VISION_MAX_TOKENS=700
MM_DOCS_VISION_MAX_IMAGE_BYTES=6000000
MM_DOCS_PDF_VISION_OCR_ENABLED=true
MM_DOCS_PDF_VISION_MAX_PAGES=2
MM_DOCS_INGEST_LOG_RETENTION_DAYS=21
MM_DOCS_INGEST_LOG_MAX_ROWS=5000
MM_DOCS_INGEST_LOG_PRUNE_BATCH=250
MM_DOCS_INGEST_LOG_PRUNE_COOLDOWN_MS=900000

# Memory Qdrant
QDRANT_MEMORY_URL=
QDRANT_MEMORY_API_KEY=

# Limits (LEX-70)
RUNS_PER_MINUTE=30
MAX_CONCURRENT_RUNS=10

# Attachments (LEX-72)
ATTACHMENT_INLINE_MAX_BYTES=524288
REQUEST_INLINE_MAX_BYTES=2097152
