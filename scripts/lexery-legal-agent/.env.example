# Lexery Legal Agent — U1 Gateway
# Copy to .env and fill values

# Server
BRAIN_PORT=3081
NODE_ENV=development

# Dev Auth (LEX-69)
DEV_API_KEY=your-dev-key-here
DEV_ALLOW_ANONYMOUS=true

# Supabase LEXERY LEGAL AGENT DB
SUPABASE_LEXERY_LEGAL_AGENT_DB_URL=https://xxx.supabase.co
SUPABASE_LEXERY_LEGAL_AGENT_DB_ANON_KEY=
SUPABASE_LEXERY_LEGAL_AGENT_DB_SERVICE_ROLE_KEY=

# R2 (for attachments overflow)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RUNS_BUCKET=lexery-legal-agent
R2_LEGISLATION_BUCKET=legislation
# Create lexery-legal-agent bucket in Cloudflare R2 if using overflow attachments.

# Limits (LEX-70)
RUNS_PER_MINUTE=30
MAX_CONCURRENT_RUNS=10

# Attachments (LEX-72)
ATTACHMENT_INLINE_MAX_BYTES=524288
REQUEST_INLINE_MAX_BYTES=2097152
