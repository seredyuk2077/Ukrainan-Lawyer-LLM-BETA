# NOTE: The repo tooling may block `.env*` example files.
# Copy this file to `.env` (or set env vars in GitHub Actions).
#
# === Qdrant ===
QDRANT_URL=https://<host>:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legislation-catalog-index
QDRANT_TIMEOUT_MS=60000
#
# === Embeddings (OpenRouter by default) ===
# Either set EMBEDDING_API_KEY or OPEN_ROUTER_API_RAG
EMBEDDING_API_KEY=
OPEN_ROUTER_API_RAG=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
EMBEDDING_TIMEOUT_MS=60000
#
# === Cloudflare R2 (S3-compatible) ===
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=legislation
#
# Use the existing prefix as-is (with spaces) unless you explicitly want an alias.
R2_PREFIX=legislation/DocListDB rada gov updater log/
#
# === Optional ===
LOG_LEVEL=info

