# NOTE:
# Some tooling blocks `.env.example`. If so, copy this file to `.env` locally.

# === Optional: Demo CLI ===
# If not set, demo defaults to the production worker URL.
CATALOG_RESOLVER_URL=https://act-catalog-resolver.andriykosrdkgames.workers.dev

# === Qdrant (DocListDB catalog) ===
QDRANT_URL=https://<your-qdrant-host>:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legislation-catalog-index
QDRANT_TIMEOUT_MS=15000

# === Embeddings (MUST match importer/updater) ===
# OpenRouter embeddings API key (same as OPEN_ROUTER_API_RAG in the repo root).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
EMBEDDING_TIMEOUT_MS=15000

# === Optional: LLM rerank (OpenRouter chat completions) ===
# In production this is enabled. Locally you can set to false to save cost.
RERANK_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RERANK_MODEL=openai/gpt-4o-mini
RERANK_TIMEOUT_MS=20000

# === Optional: cache (S3 API for Cloudflare R2) ===
# In production this is enabled. Locally you can set to false to avoid requiring R2 keys.
CACHE_ENABLED=true
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=legislation
R2_PREFIX=legislation/ActCatalogResolver/cache/

